{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTTP",
  "scopeName": "source.http",
  "patterns": [
    { "include": "#separator" },
    { "include": "#comment" },
    { "include": "#file-variable" },
    { "include": "#request-line" },
    { "include": "#header" },
    { "include": "#variable-reference" }
  ],
  "repository": {
    "separator": {
      "match": "^###.*$",
      "name": "meta.separator.http markup.heading.http"
    },
    "comment": {
      "match": "^\\s*(#|//).*$",
      "name": "comment.line.http"
    },
    "file-variable": {
      "match": "^(@[\\w.-]+)\\s*(=)\\s*(.*)$",
      "captures": {
        "1": { "name": "variable.other.http" },
        "2": { "name": "keyword.operator.assignment.http" },
        "3": { "name": "string.unquoted.http" }
      }
    },
    "request-line": {
      "match": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|TRACE|CONNECT)\\s+(\\S+)(?:\\s+(HTTP/[\\d.]+))?\\s*$",
      "captures": {
        "1": { "name": "keyword.control.http" },
        "2": { "name": "string.unquoted.url.http markup.underline.link.http" },
        "3": { "name": "constant.language.http" }
      }
    },
    "header": {
      "match": "^([\\w-]+)(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.http" },
        "2": { "name": "punctuation.separator.http" },
        "3": { "name": "string.unquoted.http" }
      }
    },
    "variable-reference": {
      "match": "\\{\\{[^{}]+\\}\\}",
      "name": "variable.other.readwrite.http"
    }
  }
}
